# ============================================================
# HyperFix + Gaia — copiez ce fichier en .env (JAMAIS commité,
# déjà ignoré par git). Renseignez les secrets hors chat.
# ============================================================

# --- Ports hôte (localhost seul, Caddy fera le proxy plus tard) ---
CHROMADB_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
MONGO_HOST_PORT=27018
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_PORT=15673
API_HOST_PORT=8000
WEB_HOST_PORT=3000
SEARXNG_HOST_PORT=8888

# --- Postgres Gaia (CHANGEZ le mot de passe) ---
POSTGRES_USER=gaia
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=langgraph

# --- WorkOS (auth) : dashboard workos.com → copiez les 2 valeurs ---
WORKOS_API_KEY=changez-moi
WORKOS_CLIENT_ID=changez-moi

# --- Voie B : Muse free via OpenCode Zen (modèle par défaut, /responses) ---
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=changez-moi

# --- Repli Gemini (vide = inactif propre en attendant la clé) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- SearXNG (générez-en un : openssl rand -hex 32) ---
SEARXNG_SECRET=changez-moi

# --- Identite backend (OAuth MCP callback + wide events) ---
HOST=http://localhost:8000
FRONTEND_URL=http://localhost:3000
GAIA_BACKEND_URL=http://gaia-backend:8000

# --- Chiffrement tokens MCP (Fernet 32B : openssl rand -base64 32) ---
MCP_ENCRYPTION_KEY=changez-moi

# --- Dev uniquement : auth bypass API (refuse en production) ---
# DEV_AUTH_BYPASS_EMAIL=samaleh2017@gmail.com

# --- URLs publiques (phase bascule : Caddy + DNS) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1/
API_BASE_URL_INTERNAL=http://gaia-backend:8000/api/v1/
